# Apache Maven Wrapper startup script, version 3.3.2

set -euf
[ "${MVNW_VERBOSE-}" != true ] || set -x

# Java executable
if [ -n "${JAVA_HOME-}" ]; then
  if [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
  else
    echo "ERROR: Cannot find java at JAVA_HOME=$JAVA_HOME" >&2
    exit 1
  fi
else
  JAVACMD="java"
  if ! command -v java >/dev/null 2>&1; then
    echo "ERROR: java not found. Set JAVA_HOME or add java to PATH." >&2
    exit 1
  fi
fi

# Find project basedir (directory containing .mvn)
find_basedir() {
  dir="$PWD"
  while [ "$dir" != "/" ]; do
    [ -d "$dir/.mvn" ] && echo "$dir" && return
    dir=$(dirname "$dir")
  done
  echo "$PWD"
}

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(find_basedir)}"

# Read distributionUrl from properties
PROPS="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
if [ ! -f "$PROPS" ]; then
  echo "ERROR: $PROPS not found" >&2
  exit 1
fi

DISTRIBUTION_URL=$(grep "^distributionUrl=" "$PROPS" | cut -d= -f2-)
if [ -z "$DISTRIBUTION_URL" ]; then
  echo "ERROR: distributionUrl not set in $PROPS" >&2
  exit 1
fi

# Override with MVNW_REPOURL if set
if [ -n "${MVNW_REPOURL-}" ]; then
  ZIP_BASENAME="${DISTRIBUTION_URL##*/}"
  VERSION="${ZIP_BASENAME#apache-maven-}"
  VERSION="${VERSION%-bin.zip}"
  DISTRIBUTION_URL="${MVNW_REPOURL}/org/apache/maven/apache-maven/${VERSION}/${ZIP_BASENAME}"
fi

# Compute cache paths
MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
ZIP_NAME="${DISTRIBUTION_URL##*/}"
DIR_NAME="${ZIP_NAME%-bin.zip}"
CACHE_DIR="${MAVEN_USER_HOME}/wrapper/dists/${DIR_NAME}"
MAVEN_HOME="${CACHE_DIR}/${DIR_NAME}"

# Download and install Maven if not cached
if [ ! -d "$MAVEN_HOME" ]; then
  mkdir -p "$CACHE_DIR"
  TMP_DIR="$(mktemp -d)"
  echo "Downloading Maven ${DIR_NAME}..."
  echo "  from: $DISTRIBUTION_URL"

  if command -v curl >/dev/null 2>&1; then
    curl -fL ${MVNW_VERBOSE:+-v} \
      ${MVNW_USERNAME:+-u "${MVNW_USERNAME}:${MVNW_PASSWORD-}"} \
      -o "$TMP_DIR/$ZIP_NAME" "$DISTRIBUTION_URL" || {
        echo "ERROR: Download failed" >&2; rm -rf "$TMP_DIR"; exit 1
      }
  elif command -v wget >/dev/null 2>&1; then
    wget ${MVNW_VERBOSE:+-v} \
      ${MVNW_USERNAME:+--user="$MVNW_USERNAME" --password="${MVNW_PASSWORD-}"} \
      -O "$TMP_DIR/$ZIP_NAME" "$DISTRIBUTION_URL" || {
        echo "ERROR: Download failed" >&2; rm -rf "$TMP_DIR"; exit 1
      }
  else
    echo "ERROR: curl or wget is required to download Maven." >&2
    exit 1
  fi

  unzip -q "$TMP_DIR/$ZIP_NAME" -d "$CACHE_DIR" || {
    echo "ERROR: Extraction failed" >&2; rm -rf "$TMP_DIR" "$MAVEN_HOME"; exit 1
  }
  rm -rf "$TMP_DIR"
  chmod +x "$MAVEN_HOME/bin/mvn"
  echo "Maven installed to $MAVEN_HOME"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
